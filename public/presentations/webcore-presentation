//  SLIDE CONTROLLER & AUTOPLAY LOGIC
// ═══════════════════════════════════════════════════════════════════════════════
let current = 0;
let slides = [];
let total = 0;
let autoplayTimer = null;
let isPlaying = false;
let elapsedSec = 0;
let timerTick = null;

function goToSlide(n, dir = 1) {
  if (n < 0 || n >= total) return;
  const prev = slides[current];
  prev.style.opacity = '0';
  prev.style.transform = dir > 0 ? 'translateX(-80px)' : 'translateX(80px)';
  prev.style.pointerEvents = 'none';

  setTimeout(() => {
    prev.style.transition = 'none';
    prev.style.transform = '';
    prev.style.transition = '';
  }, 600);

  current = n;
  const curr = slides[current];
  curr.style.opacity = '0';
  curr.style.transform = dir > 0 ? 'translateX(80px)' : 'translateX(-80px)';
  curr.style.transition = 'none';
  curr.style.pointerEvents = 'all';

  requestAnimationFrame(() => {
    curr.style.transition = 'opacity .6s ease, transform .6s cubic-bezier(.4,0,.2,1)';
    curr.style.opacity = '1';
    curr.style.transform = 'translateX(0)';
  });

  updateControls();
}

function updateControls() {
  document.getElementById('slideCounter').textContent = `${current + 1} / ${total}`;
  document.getElementById('progressBar').style.width = `${((current + 1) / total) * 100}%`;

  document.querySelectorAll('.dot').forEach((d, idx) => {
    d.classList.toggle('active', idx === current);
  });
}

function toggleAutoplay() {
  isPlaying = !isPlaying;
  const btn = document.getElementById('autoplayBtn');
  const icon = document.getElementById('playIcon');
  const txt = document.getElementById('playText');

  if (isPlaying) {
    btn.classList.add('active');
    icon.textContent = '❚❚';
    txt.textContent = 'Pause';
    autoplayTimer = setInterval(() => {
      if (current < total - 1) {
        goToSlide(current + 1, 1);
      } else {
        goToSlide(0, 1);
      }
    }, 6000);
  } else {
    btn.classList.remove('active');
    icon.textContent = '▶';
    txt.textContent = 'Auto';
    clearInterval(autoplayTimer);
  }
}

function startTimer() {
  timerTick = setInterval(() => {
    elapsedSec++;
    const m = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
    const s = String(elapsedSec % 60).padStart(2, '0');
    document.getElementById('timer').textContent = `${m}:${s}`;
  }, 1000);
}

