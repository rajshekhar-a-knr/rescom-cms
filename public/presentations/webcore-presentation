function openFeatureModal(funcName, subName, modName) {
  document.getElementById('modalTitle').textContent = funcName;
  document.getElementById('modalTag').textContent = `${modName} • ${subName}`;
  
  let desc = FEATURE_DESCRIPTIONS[funcName];
  if (!desc) {
    desc = `Provides comprehensive operational management and real-time interface capabilities for ${funcName} within ${subName}. Administrators can customize parameters, configure workflows, update database records, and manage publish states securely. Delivers a seamless, high-performance experience for website visitors, parents, and institutional stakeholders across desktop and mobile browsers.`;
  }
    
  document.getElementById('modalDesc').textContent = desc;
  document.getElementById('metaRole').textContent = modName.includes("SECURITY") ? "System Security Admin" : modName.includes("ADMISSION") ? "Admissions Officer / Web Editor" : "Super Admin / Web Controller";
  document.getElementById('metaRoute').textContent = `/admin/${modName.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
  document.getElementById('featureModal').classList.add('active');
}

function closeFeatureModal() {
  document.getElementById('featureModal').classList.remove('active');
}

// Global search engine for all features
const allFeaturesIndex = [];
modules.forEach((m, mIdx) => {
  m.submodules.forEach(sub => {
    sub.funcs.forEach(f => {
      allFeaturesIndex.push({
        feature: f,
        submodule: sub.name,
        module: m.name,
        slideIndex: mIdx + 2
      });
    });
  });
});

const searchModal = document.getElementById('searchModal');
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');

function openSearch() {
  searchModal.classList.add('active');
  searchInput.focus();
  renderSearchResults('');
}

function closeSearch() {
  searchModal.classList.remove('active');
  searchInput.value = '';
}

function renderSearchResults(query) {
  const q = query.toLowerCase().trim();
  searchResults.innerHTML = '';

  const filtered = allFeaturesIndex.filter(item =>
    item.feature.toLowerCase().includes(q) ||
    item.submodule.toLowerCase().includes(q) ||
    item.module.toLowerCase().includes(q)
  );

  if (filtered.length === 0) {
    searchResults.innerHTML = `<div style="text-align:center;color:rgba(255,255,255,.5);padding:2rem">No features found matching "${query}"</div>`;
    return;
  }

  filtered.slice(0, 35).forEach(item => {
    const div = document.createElement('div');
    div.className = 'search-item';
    div.innerHTML = `
      <div class="search-item-title">${item.feature}</div>
      <div class="search-item-sub">${item.module} &bull; ${item.submodule}</div>`;
    div.onclick = () => {
      closeSearch();
      goToSlide(item.slideIndex);
    };
    searchResults.appendChild(div);
  });
}

searchInput.addEventListener('input', (e) => renderSearchResults(e.target.value));

// ═══════════════════════════════════════════════════════════════════════════════
//  KEYBOARD & TOUCH EVENTS
// ═══════════════════════════════════════════════════════════════════════════════
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeFeatureModal();
    closeSearch();
    return;
  }
  if (searchModal.classList.contains('active')) return;

  if (e.key === 'ArrowRight' || e.key === 'PageDown') goToSlide(current + 1, 1);
  if (e.key === 'ArrowLeft' || e.key === 'PageUp') goToSlide(current - 1, -1);
  if (e.key === 'Home') goToSlide(0, -1);
  if (e.key === 'End') goToSlide(total - 1, 1);
  if (e.key === ' ') { e.preventDefault(); toggleAutoplay(); }
  if (e.key === 'f' || e.key === 'F') {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  }
  if (e.key === 's' || e.key === 'S') {
    e.preventDefault();
    openSearch();
  }
});

// Touch swipe support for mobile Devices
let touchStartX = 0;
document.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; });
document.addEventListener('touchend', (e) => {
  const touchEndX = e.changedTouches[0].screenX;
  if (touchStartX - touchEndX > 50) goToSlide(current + 1, 1);
  if (touchEndX - touchStartX > 50) goToSlide(current - 1, -1);
});

// ═══════════════════════════════════════════════════════════════════════════════
//  INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════
window.addEventListener('DOMContentLoaded', () => {
  buildBg();
  slides = buildSlides();
  total = slides.length;
  buildDots(total);
  updateControls();
  startTimer();

  document.getElementById('prevBtn').onclick = () => goToSlide(current - 1, -1);
  document.getElementById('nextBtn').onclick = () => goToSlide(current + 1, 1);
  document.getElementById('autoplayBtn').onclick = toggleAutoplay;
  document.getElementById('searchTriggerBtn').onclick = openSearch;
});
</script>
