function buildBg() {
  const bg = document.getElementById('animBg');
  const colors = ["#3B82F6", "#10B981", "#8B5CF6", "#F59E0B", "#06B6D4", "#F43F5E", "#00F0FF"];
  colors.forEach((c, i) => {
    const d = document.createElement('div');
    d.className = 'bg-orb';
    const s = 220 + Math.random() * 380;
    d.style.cssText = `width:${s}px;height:${s}px;background:${c};left:${Math.random() * 100}%;top:${Math.random() * 100}%;animation-delay:${i * 2.5}s;animation-duration:${28 + i * 3}s`;
    bg.appendChild(d);
  });

  const sb = document.getElementById('starsBg');
  for (let i = 0; i < 130; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    const sz = Math.random() * 2.5 + 1;
    s.style.cssText = `width:${sz}px;height:${sz}px;left:${Math.random() * 100}%;top:${Math.random() * 100}%;animation-delay:${Math.random() * 5}s;animation-duration:${2 + Math.random() * 4}s`;
    sb.appendChild(s);
  }
}

