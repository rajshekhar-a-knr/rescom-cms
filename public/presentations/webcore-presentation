//  NAVIGATION DOTS BUILDER
// ═══════════════════════════════════════════════════════════════════════════════
function buildDots(total) {
  const wrap = document.getElementById('navDots');
  wrap.innerHTML = '';
  for (let i = 0; i < total; i++) {
    const d = document.createElement('div');
    d.className = 'dot' + (i === 0 ? ' active' : '');
    d.title = i === 0 ? 'Title' : i === 1 ? 'Overview' : i === total - 1 ? 'Closer' : `Module ${i - 1}`;
    d.onclick = () => goToSlide(i);
    d.dataset.i = i;
    if (total > 12 && i > 1 && i < total - 1 && (i - 2) % 2 !== 0) {
      d.style.display = 'none'; // Compact dots spacing
    }
    wrap.appendChild(d);
  }
}

