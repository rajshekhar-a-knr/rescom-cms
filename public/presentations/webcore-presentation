<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WEBcore — End-to-End Platform Presentation</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        :root{
            --midnight:#0A0E27;--royal:#1E3A8A;--electric:#3B82F6;
            --cyan:#06B6D4;--emerald:#10B981;--amber:#F59E0B;
            --rose:#F43F5E;--purple:#8B5CF6;--neon:#00F0FF;
            --gold:#FBBF24;--white:#FFFFFF;--plat:#F8FAFC;
        }
        html,body{width:100%;height:100%;margin:0;padding:0;font-family:'Plus Jakarta Sans',sans-serif;background:var(--midnight);color:var(--white);overflow:hidden}
        .animated-bg{position:fixed;inset:0;z-index:0;overflow:hidden;background:linear-gradient(135deg,#0A0E27 0%,#0F1729 100%)}
        .bg-orb{position:absolute;border-radius:50%;filter:blur(90px);opacity:.12;animation:drift 32s infinite ease-in-out}
        @keyframes drift{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(110px,-90px) scale(1.25)}66%{transform:translate(-80px,70px) scale(.85)}}
        .stars{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
        .star{position:absolute;border-radius:50%;background:#fff;animation:twinkle 3s infinite ease-in-out}
        @keyframes twinkle{0%,100%{opacity:.2;transform:scale(1)}50%{opacity:.95;transform:scale(1.4)}}
        
        #slides-container{position:relative;z-index:1;width:100vw;height:100vh;overflow:hidden}
        .slide{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:clamp(1rem,2.5vh,2.5rem) clamp(1rem,3vw,3rem);opacity:0;pointer-events:none;transition:opacity .6s ease,transform .6s cubic-bezier(.4,0,.2,1)}
        .slide.active{opacity:1;pointer-events:all;transform:translateX(0)!important}
        
        /* CONTROLS & HEADER NAV */
        .controls{position:fixed;bottom:1.2rem;left:50%;transform:translateX(-50%);z-index:100;display:flex;align-items:center;gap:.8rem;background:rgba(10,14,39,.85);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.14);border-radius:50px;padding:.5rem 1.4rem;box-shadow:0 10px 40px rgba(0,0,0,.5)}
        .ctrl-btn{background:none;border:none;color:var(--white);cursor:pointer;padding:.4rem .8rem;border-radius:10px;font-size:1.1rem;transition:all .2s;opacity:.8}
        .ctrl-btn:hover{opacity:1;background:rgba(255,255,255,.12);transform:scale(1.05)}
        .slide-counter{font-size:.85rem;color:rgba(255,255,255,.8);font-weight:700;min-width:5.5rem;text-align:center;font-family:'Outfit',sans-serif}
        .progress-wrap{position:fixed;top:0;left:0;right:0;z-index:100;height:4px;background:rgba(255,255,255,.1)}
        .progress-bar{height:100%;background:linear-gradient(90deg,var(--neon),var(--electric),var(--purple));transition:width .4s ease;box-shadow:0 0 12px var(--neon)}
        .timer{font-size:.8rem;color:rgba(255,255,255,.6);font-family:'Outfit',monospace;font-weight:600}
        .autoplay-btn{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;cursor:pointer;padding:.35rem clamp(.6rem,1vw,1rem);border-radius:20px;font-size:.78rem;font-weight:600;transition:all .2s;display:flex;align-items:center;gap:.4rem}
        .autoplay-btn:hover{background:rgba(255,255,255,.2)}
        .autoplay-btn.active{background:linear-gradient(135deg,var(--electric),var(--purple));border-color:transparent;box-shadow:0 0 15px rgba(59,130,246,.5)}
        .search-trigger-btn{background:rgba(0,240,255,.12);border:1px solid rgba(0,240,255,.3);color:var(--neon);cursor:pointer;padding:.35rem .9rem;border-radius:20px;font-size:.78rem;font-weight:700;transition:all .2s}
        .search-trigger-btn:hover{background:rgba(0,240,255,.25);transform:scale(1.03)}

        .nav-dots{position:fixed;right:1.2rem;top:50%;transform:translateY(-50%);z-index:100;display:flex;flex-direction:column;gap:.45rem}
        .dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.3);cursor:pointer;transition:all .3s}
        .dot.active{background:var(--neon);width:8px;height:22px;border-radius:4px;box-shadow:0 0 10px var(--neon)}
        .dot:hover{background:rgba(255,255,255,.8)}

        /* TITLE SLIDE DESIGN */
        .title-slide{text-align:center;width:100%;max-width:1100px}
        .title-slide .tagline{font-size:clamp(1.1rem,2.8vw,2.1rem);color:var(--gold);font-weight:800;margin:.6rem 0;letter-spacing:.05em;animation:fadeUp 1s 0.3s both}
        .title-slide .subtitle{font-size:clamp(.95rem,1.8vw,1.4rem);color:var(--cyan);font-weight:600;animation:fadeUp 1s 0.6s both}
        .title-slide .stats-row{display:flex;gap:clamp(1rem,3vw,3rem);justify-content:center;margin-top:2.2rem;animation:fadeUp 1s 0.9s both}
        .title-stat{text-align:center}
        .title-stat .num{font-family:'Outfit',sans-serif;font-size:clamp(2.2rem,4vw,3.2rem);font-weight:900;background:linear-gradient(135deg,var(--neon),var(--electric));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
        .title-stat .lbl{font-size:.78rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.12em;margin-top:.2rem;font-weight:600}
        .stat-sep{width:1px;height:45px;background:rgba(255,255,255,.15);align-self:center}
        
        @keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
        
        /* LOGO EMBLEM */
        .logo-ring-wrap{position:relative;width:170px;height:170px;margin:0 auto 1.2rem;display:flex;align-items:center;justify-content:center}
        .logo-outer-ring{position:absolute;inset:-12px;border-radius:50%;border:2px solid transparent;background:linear-gradient(135deg,var(--neon),var(--purple),var(--electric)) border-box;-webkit-mask:linear-gradient(#fff 0 0) padding-box,linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude;animation:spinRing 4s linear infinite;opacity:.85}
        .logo-inner-ring{position:absolute;inset:-5px;border-radius:50%;border:2px solid transparent;background:linear-gradient(135deg,var(--gold),var(--amber),var(--neon)) border-box;-webkit-mask:linear-gradient(#fff 0 0) padding-box,linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude;animation:spinRing 6s linear infinite reverse;opacity:.75}
        @keyframes spinRing{to{transform:rotate(360deg)}}
        .logo-circle{width:155px;height:155px;border-radius:50%;background:#ffffff;border:3px solid rgba(255,255,255,0.9);display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 0 50px rgba(0,240,255,.6),0 0 90px rgba(139,92,246,.4),inset 0 0 15px rgba(0,0,0,.05);animation:logoPulse 3s ease-in-out infinite;position:relative;overflow:hidden;padding:6px}
        @keyframes logoPulse{0%,100%{box-shadow:0 0 40px rgba(0,240,255,.5),0 0 70px rgba(139,92,246,.4)}50%{box-shadow:0 0 75px rgba(0,240,255,.8),0 0 110px rgba(139,92,246,.6)}}
        .webcore-logo-img{width:138px;height:138px;object-fit:contain;border-radius:50%;animation:logoFloat 4s ease-in-out infinite;background:#ffffff}

        @keyframes logoFloat{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-3px) scale(1.02)}}
        .logo-text-main{font-family:'Outfit',sans-serif;font-size:2rem;font-weight:900;letter-spacing:1px;background:linear-gradient(135deg,#fff,var(--neon));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .logo-text-sub{font-size:.65rem;font-weight:800;letter-spacing:3px;color:var(--gold);text-transform:uppercase;margin-top:-2px}


        /* OVERVIEW SLIDE */
        .overview-slide{width:100%;max-width:1320px}
        .slide-header{text-align:center;margin-bottom:1.4rem}
        .slide-header .eyebrow{font-size:.78rem;text-transform:uppercase;letter-spacing:.22em;color:var(--neon);font-weight:800;margin-bottom:.4rem}
        .slide-header h2{font-family:'Outfit',sans-serif;font-size:clamp(1.8rem,4.5vw,3.2rem);font-weight:900}
        
        .modules-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.9rem;width:100%;max-width:1250px;max-height:calc(100vh - 240px);overflow-y:auto;padding-right:.3rem}
        .modules-grid::-webkit-scrollbar{width:5px}
        .modules-grid::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:3px}
        
        .mod-chip{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:.8rem .9rem;text-align:center;cursor:pointer;transition:all .3s;position:relative;overflow:hidden;backdrop-filter:blur(10px)}
        .mod-chip::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--chip-color,var(--electric))25,transparent);opacity:0;transition:opacity .3s}
        .mod-chip:hover{transform:translateY(-4px);border-color:var(--chip-color,var(--electric));box-shadow:0 10px 30px rgba(0,0,0,.4)}
        .mod-chip:hover::before{opacity:1}
        .mod-chip .chip-icon{font-size:1.5rem;margin-bottom:.3rem;display:block}
        .mod-chip .chip-name{font-size:.76rem;font-weight:700;color:rgba(255,255,255,.95);line-height:1.2}

        /* MODULE DEEP DIVE SLIDES */
        .module-slide{width:100%;max-width:1300px;position:relative}
        .mod-header{display:flex;align-items:flex-start;gap:1.8rem;margin-bottom:1.4rem}
        .mod-icon-wrap{width:75px;height:75px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:2.2rem;flex-shrink:0;position:relative;overflow:hidden;animation:iconPop .6s cubic-bezier(.34,1.56,.64,1) both;box-shadow:0 10px 30px rgba(0,0,0,.4)}
        @keyframes iconPop{from{opacity:0;transform:scale(.4) rotate(-20deg)}to{opacity:1;transform:scale(1) rotate(0)}}
        .mod-number{font-size:.78rem;text-transform:uppercase;letter-spacing:.2em;font-weight:800;margin-bottom:.2rem}
        .mod-title{font-family:'Outfit',sans-serif;font-size:clamp(1.6rem,3.8vw,2.8rem);font-weight:900;line-height:1.1}
        .mod-tagline{font-size:clamp(.85rem,1.5vw,1.15rem);color:rgba(255,255,255,.7);margin-top:.3rem;font-weight:600}
        .mod-description{font-size:clamp(.82rem,1.2vw,.96rem);color:rgba(255,255,255,.75);line-height:1.5;margin-bottom:1.2rem;padding:.9rem 1.2rem;background:rgba(255,255,255,.04);border-left:4px solid;border-radius:0 10px 10px 0;backdrop-filter:blur(10px)}
        
        .submodules-grid{display:grid;gap:.8rem;max-height:calc(100vh - 290px);overflow-y:auto;padding-right:.4rem}
        .submodules-grid::-webkit-scrollbar{width:4px}
        .submodules-grid::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:2px}
        
        .submodule-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.11);border-radius:14px;padding:.9rem 1.1rem;position:relative;overflow:hidden;transition:all .3s}
        .submodule-card:hover{transform:translateX(5px);border-color:rgba(255,255,255,.25);background:rgba(255,255,255,.08)}
        .sub-name{font-weight:800;font-size:.88rem;margin-bottom:.5rem;display:flex;align-items:center;gap:.5rem}
        .funcs-wrap{display:flex;flex-wrap:wrap;gap:.35rem}
        .func-tag{font-size:.72rem;padding:.25rem .65rem;border-radius:20px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.9);white-space:nowrap;transition:all .2s;cursor:pointer}
        .func-tag:hover{background:rgba(255,255,255,.2);transform:scale(1.04);color:#fff}
        
        .grid-2{grid-template-columns:repeat(2,1fr)}
        .grid-3{grid-template-columns:repeat(3,1fr)}
        .grid-1{grid-template-columns:1fr}

        /* CLOSER SLIDE */
        .closer-slide{text-align:center;width:100%;max-width:1050px;max-height:calc(100vh - 110px);display:flex;flex-direction:column;align-items:center;justify-content:center;padding-bottom:3.2rem;position:relative}
        .closer-slide h2{font-family:'Outfit',sans-serif;font-size:clamp(1.8rem,4.2vw,3.4rem);font-weight:900;background:linear-gradient(135deg,var(--white),var(--neon),var(--purple));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:.3rem;filter:drop-shadow(0 0 25px rgba(0,240,255,.4));line-height:1.15}
        .closer-slide .sub{font-size:clamp(.85rem,1.5vw,1.15rem);color:var(--gold);font-weight:700;margin-bottom:.8rem}
        .cta-wrap{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;margin-top:.8rem}
        .cta-btn{padding:.7rem 1.5rem;border-radius:50px;font-weight:800;font-size:.88rem;cursor:pointer;border:none;transition:all .3s;display:inline-flex;align-items:center;gap:.4rem}
        .cta-primary{background:linear-gradient(135deg,var(--electric),var(--purple));color:#fff;box-shadow:0 6px 25px rgba(59,130,246,.4)}
        .cta-primary:hover{transform:translateY(-2px);box-shadow:0 10px 35px rgba(59,130,246,.6)}
        .cta-secondary{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.3)}
        .cta-secondary:hover{background:rgba(255,255,255,.12)}
        .cta-website{background:linear-gradient(135deg,var(--emerald),var(--electric));color:#fff;box-shadow:0 6px 25px rgba(16,185,129,.4)}
        .cta-website:hover{transform:translateY(-2px);box-shadow:0 10px 35px rgba(16,185,129,.6)}
        .cta-admin{background:linear-gradient(135deg,var(--purple),var(--rose));color:#fff;box-shadow:0 6px 25px rgba(139,92,246,.4)}
        .cta-admin:hover{transform:translateY(-2px);box-shadow:0 10px 35px rgba(139,92,246,.6)}

        .closer-modules-list{display:flex;flex-wrap:wrap;gap:.35rem;justify-content:center;max-width:960px;max-height:24vh;overflow-y:auto;margin:.4rem auto 1rem;padding:.4rem;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.2) transparent}
        .closer-modules-list::-webkit-scrollbar{width:4px}
        .closer-modules-list::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:2px}
        .closer-chip{font-size:.68rem;padding:.25rem .65rem;border-radius:20px;border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.8);cursor:pointer;transition:all .2s;white-space:nowrap}
        .closer-chip:hover{background:rgba(255,255,255,.18);transform:scale(1.04)}


        .pill-badge{padding:.35rem .9rem;border-radius:50px;border:1px solid var(--pc,var(--electric));color:var(--pc,var(--electric));font-size:clamp(.68rem,1vw,.82rem);font-weight:700;background:rgba(255,255,255,.05);backdrop-filter:blur(10px)}
        .mod-glow{position:absolute;width:450px;height:450px;border-radius:50%;filter:blur(110px);opacity:.08;right:-100px;top:-100px;pointer-events:none}

        /* FEATURE INSPECTOR MODAL */
        .modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(10,14,39,.85);backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s ease}
        .modal-overlay.active{opacity:1;pointer-events:all}
        .modal-box{background:linear-gradient(135deg,#131B3E,#0A0E27);border:1px solid rgba(255,255,255,.2);border-radius:24px;padding:2rem;width:90%;max-width:620px;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.7);transform:scale(.9);transition:transform .3s cubic-bezier(.34,1.56,.64,1)}
        .modal-overlay.active .modal-box{transform:scale(1)}
        .modal-close{position:absolute;right:1.2rem;top:1.2rem;background:none;border:none;color:#fff;font-size:1.5rem;cursor:pointer;opacity:.7;transition:opacity .2s}
        .modal-close:hover{opacity:1}
        .modal-tag{display:inline-block;font-size:.7rem;padding:.2rem .6rem;border-radius:20px;background:rgba(0,240,255,.15);color:var(--neon);font-weight:700;margin-bottom:.8rem;text-transform:uppercase}
        .modal-title{font-family:'Outfit',sans-serif;font-size:1.6rem;font-weight:800;margin-bottom:.5rem;color:#fff}
        .modal-desc{font-size:.9rem;color:rgba(255,255,255,.75);line-height:1.6;margin-bottom:1.2rem}
        .modal-meta{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;background:rgba(255,255,255,.05);padding:1rem;border-radius:12px;font-size:.8rem}
        .meta-lbl{color:rgba(255,255,255,.5);font-weight:600;margin-bottom:.2rem}
        .meta-val{color:var(--neon);font-weight:700}

        /* SEARCH MODAL */
        .search-modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(10,14,39,.9);backdrop-filter:blur(20px);display:flex;flex-direction:column;align-items:center;padding:4rem 1rem 2rem;opacity:0;pointer-events:none;transition:opacity .3s ease}
        .search-modal-overlay.active{opacity:1;pointer-events:all}
        .search-input-wrap{width:100%;max-width:700px;position:relative;margin-bottom:1.5rem}
        .search-input{width:100%;padding:1.1rem 1.6rem;border-radius:50px;background:rgba(255,255,255,.08);border:2px solid var(--electric);color:#fff;font-size:1.1rem;outline:none;box-shadow:0 0 30px rgba(59,130,246,.3);font-family:'Plus Jakarta Sans',sans-serif}
        .search-input::placeholder{color:rgba(255,255,255,.4)}
        .search-results{width:100%;max-width:700px;max-height:60vh;overflow-y:auto;display:flex;flex-direction:column;gap:.6rem;padding-right:.3rem}
        .search-item{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:.9rem 1.2rem;cursor:pointer;transition:all .2s}
        .search-item:hover{background:rgba(255,255,255,.12);border-color:var(--neon);transform:translateX(5px)}
        .search-item-title{font-weight:700;font-size:.95rem;color:#fff}
        .search-item-sub{font-size:.78rem;color:var(--cyan);margin-top:.2rem}
        
        #particleCanvas{position:fixed;inset:0;z-index:0;pointer-events:none}
    </style>
</head>
<body>

<canvas id="particleCanvas"></canvas>
<div class="animated-bg" id="animBg"></div>
<div class="stars" id="starsBg"></div>

<div class="progress-wrap"><div class="progress-bar" id="progressBar"></div></div>

<div id="slides-container"></div>
<div class="nav-dots" id="navDots"></div>

<div class="controls">
    <button class="ctrl-btn" id="prevBtn" title="Previous Slide (Left Arrow)">&#8592;</button>
    <span class="slide-counter" id="slideCounter">1 / 30</span>
    <button class="ctrl-btn" id="nextBtn" title="Next Slide (Right Arrow)">&#8594;</button>
    <button class="autoplay-btn" id="autoplayBtn" title="Toggle Autoplay Mode (Spacebar)">
        <span id="playIcon">&#9654;</span> <span id="playText">Auto</span>
    </button>
    <button class="search-trigger-btn" id="searchTriggerBtn" title="Search Features (Key: S)">🔍 Search</button>
    <span class="timer" id="timer">00:00</span>
</div>

<!-- FEATURE INSPECTOR MODAL -->
<div class="modal-overlay" id="featureModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeFeatureModal()">&times;</button>
        <span class="modal-tag" id="modalTag">FEATURE SPECIFICATION</span>
        <div class="modal-title" id="modalTitle">Feature Title</div>
        <div class="modal-desc" id="modalDesc">Detailed specification and administrative workflow overview for this module feature.</div>
        <div class="modal-meta">
            <div>
                <div class="meta-lbl">Target Audience / Role</div>
                <div class="meta-val" id="metaRole">Super Admin / Web Editors</div>
            </div>
            <div>
                <div class="meta-lbl">Platform Route / Component</div>
                <div class="meta-val" id="metaRoute">/admin/...</div>
            </div>
        </div>
    </div>
</div>

<!-- SEARCH MODAL -->
<div class="search-modal-overlay" id="searchModal">
    <div class="search-input-wrap">
        <input type="text" class="search-input" id="searchInput" placeholder="Search 250+ features, modules, or tools... (Press ESC to close)" autofocus>
    </div>
    <div class="search-results" id="searchResults"></div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════════════════════
//  WEBcore MODULE DATA — 26 Comprehensive Core Modules & 260+ Features
// ═══════════════════════════════════════════════════════════════════════════════
const modules = [
  {
    id: 1, name: "WEBSITE PAGES & DYNAMIC CMS", icon: "🌐", color: "#3B82F6",
    tagline: "Core Content & Dynamic Page Architecture",
    desc: "Comprehensive content management for Home About, Facilities, Leadership, History, Vision & Mission, Infrastructure, and customizable policy pages.",
    submodules: [
      { name: "About & Vision Pages", icon: "🏛️", funcs: ["History Timeline", "Vision & Mission Statements", "Leadership & Management Profiles", "Resource Links", "Credentia & Affiliations"] },
      { name: "Policy & Governance", icon: "📜", funcs: ["Privacy Policy", "Terms & Conditions", "Refund Policy", "Custom Policy Pages", "Draft/Publish Workflow"] },
      { name: "Dynamic Facilities Builder", icon: "🏢", funcs: ["Home Facility Items", "Campus Infrastructure", "Facility Image Galleries", "Custom Detail Slugs"] },
      { name: "School Details & Branding", icon: "⚙️", funcs: ["School Name & Code", "Favicon & Logo Config", "Affiliation Specs", "Contact Info & Maps"] }
    ]
  },
  {
    id: 2, name: "HOMEPAGE CAROUSEL & HEADER ENGINE", icon: "🎠", color: "#0EA5E9",
    tagline: "Hero Media Banner & Layout Customizer",
    desc: "Manage homepage hero banner carousels, section ordering, active image toggles, and customized headers for Admissions, Learning, and Campus sections.",
    submodules: [
      { name: "Homepage Carousel Manager", icon: "🖼️", funcs: ["Hero Image Upload", "Slide Sequence Reordering", "Active/Inactive Toggle", "Slide Caption & CTA Links"] },
      { name: "Section Layout Builder", icon: "🧩", funcs: ["Section Drag-and-Drop Order", "Section Visibility Controls", "Layout Presets", "Section Background Config"] },
      { name: "Section Header Customizer", icon: "📐", funcs: ["Admissions Home Header", "Learning Home Header", "Our Campus Home Header", "Custom Taglines"] },
      { name: "Home Facility Items Carousel", icon: "🎡", funcs: ["Home Facility Cards", "Icon Customizer", "Display Sequence", "Click-through URLs"] }
    ]
